<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keepScreenOn="true"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center">

        <Button
            android:id="@+id/button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_speed"/>

        <Button
            android:id="@+id/btn_source"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_source"/>

        <Button
            android:id="@+id/btn_tracks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_tracks"/>

        <Button
            android:id="@+id/btn_mediaplayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_mediaplayer"/>

        <Button
            android:id="@+id/btn_sharepoint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_sharepoint"/>

        <TextView
            android:id="@+id/aidl_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/aidl_connecting"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="12sp"/>

    </LinearLayout>

</RelativeLayout>
