<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Exojavademo"
        tools:targetApi="31">
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 集成自 MediaPlayerWithSurfaceView：MediaPlayer + SurfaceView 播放演示 -->
        <activity
            android:name=".MediaPlayerActivity"
            android:label="@string/btn_mediaplayer"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|keyboardHidden"
            android:exported="false"/>

        <!-- 集成自 MediaPlayerWithSurfaceView：WebView 检查 SharePoint 认证 Cookie -->
        <activity
            android:name=".WebViewActivity"
            android:label="@string/btn_sharepoint"
            android:exported="false"/>

        <!-- AIDL 服务端（自托管），外部应用可按该 Action 绑定 -->
        <service
            android:name=".MyService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.example.exo_java_demo.AIDL_SERVICE"/>
            </intent-filter>
        </service>
    </application>
    <queries>
        <package android:name="com.example.mediaplayerwithsurfaceview"/>
        <intent>
            <action android:name='com.example.mediaplayerwithsurfaceview'/>
        </intent>
    </queries>
</manifest>